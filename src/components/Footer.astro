<style>
  .gf {
    --ink: #0a0a0a; --ink-2: #55585f; --ink-3: #6b6f76; --line: rgba(10,10,10,.12); --hair: rgba(10,10,10,.07); --accent: #1b5ebe;
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    background: #fff; border-top: 1px solid var(--line); padding: 64px 0 32px;
    font-family: "M PLUS 1", sans-serif; font-size: 14px; line-height: 1.85; color: var(--ink-2); -webkit-font-smoothing: antialiased;
  }
  .gf-in { width: min(1200px, 100% - clamp(32px, 8vw, 112px)); margin: 0 auto; }
  .gf-cols { display: grid; grid-template-columns: minmax(0, 4fr) repeat(3, minmax(0, 2fr)); gap: 40px; }
  .gf-logo { font-family: "Geist", sans-serif; font-weight: 700; font-size: 21px; letter-spacing: -.045em; display: inline-flex; align-items: center; gap: 9px; min-height: 44px; color: var(--ink); text-decoration: none; }
  .gf-logo i { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  .gf-brand p { margin-top: 14px; max-width: 22em; line-height: 1.8; }
  .gf-addr a { color: var(--ink-2); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .gf-h { font-family: "Geist Mono", ui-monospace, monospace; font-size: 14px; font-weight: 500; color: var(--ink-3); letter-spacing: .06em; margin-bottom: 8px; }
  .gf ul { list-style: none; margin: 0; padding: 0; }
  .gf ul a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: none; transition: color .4s var(--ease); }
  .gf ul a:hover { color: var(--accent); }
  .gf-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--hair); }
  .gf-bottom a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); text-decoration: none; }
  @media (max-width: 767px) {
    .gf { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
    .gf-cols { grid-template-columns: 1fr 1fr; }
    .gf-brand { grid-column: 1 / -1; }
  }
</style>
