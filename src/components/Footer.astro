---
import LineButton from './LineButton.astro'
---

<!-- Cream section (Tomoro-style insights/footer) -->
<footer>
  <!-- Dark footer -->
  <div class="footer-dark">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-10">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-10">

        <!-- Brand -->
        <div class="md:col-span-1">
          <p style="font-family:'Inter',sans-serif; font-weight:800; font-size:22px; letter-spacing:-0.03em; color:#FFFFFF; margin-bottom:16px;">
            altshift
          </p>
          <p class="footer-muted mb-1">福岡県福岡市</p>
          <a href="mailto:contact@altshift.jp" class="footer-muted block mb-4">contact@altshift.jp</a>
          <p class="text-xs" style="color:var(--color-ink-dim);">
            AIを、経営の武器に。
          </p>
          <div class="flex gap-4 mt-4">
            <a href="https://x.com/daiki_and_ai" target="_blank" rel="noopener noreferrer" class="footer-muted" style="display:inline-flex; align-items:center; gap:4px; font-size:12px;" aria-label="X (Twitter)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X
            </a>
            <a href="https://note.com/daiki_and_ai" target="_blank" rel="noopener noreferrer" class="footer-muted" style="display:inline-flex; align-items:center; gap:4px; font-size:12px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="3" opacity="0.8"/><text x="12" y="16" text-anchor="middle" fill="white" font-size="10" font-weight="700" font-family="sans-serif">n</text></svg>
              note
            </a>
          </div>
        </div>

        <!-- Services -->
        <div>
          <p class="text-xs font-semibold mb-5" style="color:var(--color-ink-muted); letter-spacing:0.1em; text-transform:uppercase;">サービス</p>
          <ul class="flex flex-col gap-3">
            <li><a href="/service/ai-search" class="footer-muted">AI検索対策</a></li>
            <li><a href="/service/ai-automation" class="footer-muted">AI業務自動化</a></li>
            <li><a href="/service/ai-consulting" class="footer-muted">AI顧問</a></li>
          </ul>
        </div>

        <!-- Links -->
        <div>
          <p class="text-xs font-semibold mb-5" style="color:var(--color-ink-muted); letter-spacing:0.1em; text-transform:uppercase;">リンク</p>
          <ul class="flex flex-col gap-3">
            <li><a href="/pricing" class="footer-muted">料金</a></li>
            <li><a href="/case" class="footer-muted">導入事例</a></li>
            <li><a href="/company" class="footer-muted">会社情報</a></li>
            <li><a href="/faq" class="footer-muted">よくある質問</a></li>
            <li><a href="/glossary" class="footer-muted">AI・検索用語集</a></li>
            <li><a href="/contact" class="footer-muted">お問い合わせ</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <p class="text-xs font-semibold mb-5" style="color:var(--color-ink-muted); letter-spacing:0.1em; text-transform:uppercase;">お問い合わせ</p>
          <div class="flex flex-col gap-3">
            <a href="/contact" class="btn-primary justify-center" style="font-size:13px; padding:12px 20px; min-height:44px;">
              お問い合わせ
            </a>
            <LineButton class="justify-center" />
            <p class="text-xs text-center" style="color:rgba(255,255,255,0.45);">LINE登録でAI導入チェックリストプレゼント</p>
          </div>
        </div>
      </div>
    </div>

    <div style="border-top:1px solid rgba(255,255,255,0.06);">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 py-5 flex items-center justify-between flex-wrap gap-4">
        <p class="text-xs" style="color:var(--color-ink-dim);">&copy; 2026 AltShift. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/company#legal" class="text-xs footer-muted">特定商取引法</a>
        </div>
      </div>
    </div>
  </div>
</footer>
