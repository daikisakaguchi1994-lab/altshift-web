---
// 全ページ共通のナビ（2026-11-21 新しいトップと同じ形にそろえた）
// 上に固定。高さはパソコン 76px・スマホ 64px（各ページの上の余白はこの高さより大きく取ってある）
const path = Astro.url.pathname
const items: [string, string][] = [
  ['/service', 'サービス'],
  ['/pricing', '料金'],
  ['/case', '事例'],
  ['/company', '会社情報'],
]
// 今いるページは page、その配下のページ（例 /service/ai-search）は true
const isCur = (h: string) => (path === h || path === h + '/' ? 'page' : path.startsWith(h + '/') ? 'true' : undefined)
// overHero：薄い地の1画面目（例 ".hero"）の上にいる間だけ、帯をなくして地になじませる。渡さないページは今までどおり
const { overHero } = Astro.props as { overHero?: string }
---

<header id="site-nav" class:list={['gn', overHero && 'gn-over']} data-over-hero={overHero}>
  <div class="gn-in">
    <a class="gn-logo" href="/" aria-label="AltShift トップ"><i></i>altshift</a>
    <nav class="gn-links" aria-label="メイン">
      {items.map(([h, t]) => <a href={h} aria-current={isCur(h)}>{t}</a>)}
      <a class="gn-cta" href="/contact">無料相談（30分）</a>
    </nav>
    <button class="gn-menu" id="gn-menu" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="gn-sp"><i></i><i></i></button>
  </div>
  <nav class="gn-sp" id="gn-sp" aria-label="メニュー">
    {items.map(([h, t]) => <a href={h} aria-current={isCur(h)}>{t}</a>)}
    <a href="/faq">よくある質問</a>
    <a href="/blog">ナレッジ</a>
    <a class="gn-cta" href="/contact">無料相談（30分）</a>
  </nav>
</header>

<style>
  /* ページ内のリンク（#...）で飛んだとき、見出しが固定ナビの下に隠れないようにする */
  :global(html) { scroll-padding-top: 92px; }
  .gn {
    --ink: #0a0a0a; --ink-2: #55585f; --line: rgba(10,10,10,.12); --hair: rgba(10,10,10,.07); --accent: #1b5ebe;
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: rgba(255,255,255,.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hair);
    font-family: "M PLUS 1", sans-serif; color: var(--ink); -webkit-font-smoothing: antialiased;
  }
  .gn-in { width: min(1200px, 100% - clamp(32px, 8vw, 112px)); margin: 0 auto; height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .gn-logo { font-family: "Geist", sans-serif; font-weight: 700; font-size: 21px; letter-spacing: -.045em; display: inline-flex; align-items: center; gap: 9px; min-height: 44px; color: var(--ink); text-decoration: none; }
  .gn-logo i { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  .gn-links { display: flex; align-items: center; gap: 32px; font-size: 14px; font-feature-settings: "palt"; }
  .gn-links a { min-height: 44px; display: inline-flex; align-items: center; color: var(--ink-2); text-decoration: none; transition: color .5s var(--ease); }
  .gn-links a:hover, .gn-links a[aria-current] { color: var(--ink); }
  .gn-links a[aria-current] { box-shadow: inset 0 -1.5px 0 var(--accent); }
  .gn-links .gn-cta { padding: 0 18px; background: var(--ink); color: #fff; border-radius: 999px; font-weight: 500; }
  .gn-links .gn-cta:hover { color: #fff; }
  .gn-menu { display: none; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 999px; background: #fff; flex-direction: column; align-items: center; justify-content: center; gap: 5px; cursor: pointer; }
  .gn-menu i { width: 16px; height: 1.5px; background: var(--ink); display: block; transition: transform .5s var(--ease); }
  .gn-menu[aria-expanded="true"] i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .gn-menu[aria-expanded="true"] i:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  .gn-sp { display: none; }
  /* 濃い地の1画面目の上にいる間（指定のあるページだけ）：ヘッダーを黒に、字を白に、相談ボタンを白い丸に。スマホのメニューを開いたときは白に戻す */
  .gn[data-over-hero] { transition: background-color .4s var(--ease), border-color .4s var(--ease); }
  .gn[data-over-hero] .gn-links .gn-cta { transition: background-color .4s var(--ease), color .4s var(--ease), box-shadow .4s var(--ease); }
  .gn[data-over-hero] .gn-logo { transition: color .4s var(--ease); }
  /* 指定のあるページ（トップ）は、ヘッダーを少し低く・相談ボタンを小さく（スマホはもともと 64px） */
  @media (min-width: 768px) { .gn[data-over-hero] .gn-in { height: 64px; } .gn[data-over-hero] .gn-links .gn-cta { min-height: 36px; padding: 0 16px; } }
  .gn.gn-over:not(.open) { --ink: #fff; --ink-2: rgba(255,255,255,.76); --line: rgba(255,255,255,.3); background: #000; border-bottom-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .gn.gn-over:not(.open) .gn-links .gn-cta { background: #fff; color: #000; }
  .gn.gn-over:not(.open) .gn-links .gn-cta:hover { background: rgba(255,255,255,.86); color: #000; }
  .gn.gn-over:not(.open) .gn-menu { background: transparent; }
  @media (max-width: 767px) {
    .gn-in { height: 64px; }
    .gn-links { display: none; }
    .gn-menu { display: flex; }
    .gn.open { background: #fff; }
    .gn.open .gn-sp { display: block; }
    .gn-sp { padding: 4px 16px 20px; border-top: 1px solid var(--hair); max-height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain; }
    .gn-sp a { display: flex; align-items: center; min-height: 52px; border-bottom: 1px solid var(--hair); font-size: 16px; color: var(--ink); text-decoration: none; }
    .gn-sp a[aria-current] { color: var(--accent); }
    .gn-sp .gn-cta { justify-content: center; margin-top: 14px; border: 0; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 500; }
  }
</style>

<script>
  const header = document.getElementById('site-nav')
  const btn = document.getElementById('gn-menu')
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true'
    btn.setAttribute('aria-expanded', String(open))
    btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く')
    header?.classList.toggle('open', open)
  })
  // 1画面目の上にいる間だけ、地になじませる（指定のあるページだけ）
  const zone = header?.dataset.overHero ? document.querySelector(header.dataset.overHero) : null
  const bar = header?.querySelector('.gn-in')
  if (header && zone && bar) {
    let wait = false
    const upd = () => { wait = false; header.classList.toggle('gn-over', zone.getBoundingClientRect().bottom > bar.getBoundingClientRect().height) }
    addEventListener('scroll', () => { if (!wait) { wait = true; requestAnimationFrame(upd) } }, { passive: true })
    addEventListener('resize', upd)
    upd()
  }
</script>
