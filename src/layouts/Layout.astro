---
import '../styles/global.css'

export interface Props {
  title?: string
  description?: string
  ogImage?: string
  schemaData?: object
}

const {
  title = 'AltShift｜福岡の中小企業向けAIコンサルティング・AI導入支援',
  description = '福岡発、中小企業専門のAIコンサルティング。AI導入戦略からシステム開発・Web制作・LINE自動化まで一貫支援。無料相談受付中。',
  ogImage = '/images/og-default.png',
  schemaData,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, 'https://altshift.jp').href
const ogImageURL = new URL(ogImage, 'https://altshift.jp').href
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="AltShift" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="alternate" hreflang="ja" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700;900&family=Inter:wght@300;400;500;600;700;800;900&family=Geist:wght@500;600;700&family=Geist+Mono:wght@400;500&family=M+PLUS+1:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />

    {schemaData && (
      <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(schemaData)}</script>`} />
    )}

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AltShift",
      "alternateName": ["オルトシフト", "オルタシフト", "アルトシフト"],
      "url": "https://altshift.jp",
      "publisher": {"@id": "https://altshift.jp/#organization"},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://altshift.jp/blog?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "ProfessionalService"],
      "@id": "https://altshift.jp/#organization",
      "name": "AltShift",
      "alternateName": ["オルトシフト", "オルタシフト", "アルトシフト", "Alt Shift"],
      "description": "福岡の中小企業向けにAIの導入を支援する会社。集客を増やすAI検索対策、手作業を減らすAI業務自動化、両方をまとめて任せられるAI顧問を提供。",
      "url": "https://altshift.jp",
      "email": "contact@altshift.jp",
      "image": "https://altshift.jp/images/og-default.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "福岡市",
        "addressRegion": "福岡県",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 33.5904,
        "longitude": 130.4017
      },
      "areaServed": [
        {"@type": "City", "name": "福岡市"},
        {"@type": "State", "name": "福岡県"},
        {"@type": "Country", "name": "日本"}
      ],
      "founder": {
        "@type": "Person",
        "name": "坂口 大樹",
        "jobTitle": "代表 / AI Consultant",
        "url": "https://altshift.jp/company"
      },
      "knowsAbout": ["AI導入支援", "AI顧問", "AI検索対策", "AI業務自動化", "生成AI活用", "SEO", "MEO", "AEO", "GEO", "LLMO", "AIO", "構造化データ", "LINE自動化", "AI活用研修"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AltShiftの商品",
        "itemListElement": [
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "AI検索対策", "description": "ChatGPT・Google・地図で推薦されるための月額サービス（SEO・MEO・AEO・GEO・LLMO・AIOに一括対応）。先着10社は月額55,000円（税込）、通常は月額88,000円（税込）", "url": "https://altshift.jp/service/ai-search"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "AI業務自動化", "description": "見積もり・日報・問い合わせ対応などの手作業を減らす仕組みづくり。単発の自動化からAI内製化パッケージ・AI活用研修・システム開発まで。個別見積もり", "url": "https://altshift.jp/service/ai-automation"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "AI顧問", "description": "外部CAIO（最高AI責任者）として、業務の自動化とAI検索対策を標準で含めて毎月まとめて支援。月額150,000〜300,000円（税込）", "url": "https://altshift.jp/service/ai-consulting"}}
        ]
      },
      "priceRange": "AI検索対策 月額55,000円〜（税込）、AI顧問 月額150,000〜300,000円（税込）、AI業務自動化 個別見積もり",
      "openingHours": "Mo-Fr 10:00-18:00",
      "sameAs": ["https://note.com/daiki_and_ai", "https://x.com/daiki_and_ai", "https://lin.ee/ySjX76bl"]
    }
    </script>
  </head>
  <body>
    <slot />

    <!-- Mobile fixed CTA（ヒーロー表示中は非表示） -->
    <a href="/contact"
       id="mobile-cta"
       class="md:hidden fixed bottom-0 left-0 right-0 z-50 flex items-center justify-center gap-2 text-white font-semibold text-sm is-hidden"
       style="background-color: var(--color-cta); padding: 16px 16px calc(16px + env(safe-area-inset-bottom));">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      無料相談する（30分）
    </a>

    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      // 下部固定バー: ヒーローが見えている間は非表示
      const mobileCta = document.getElementById('mobile-cta');
      const hero = document.querySelector('.hero-gradient, [data-hero]');
      if (mobileCta && hero) {
        const heroObs = new IntersectionObserver(([entry]) => {
          mobileCta.classList.toggle('is-hidden', entry.isIntersecting);
        }, { threshold: 0 });
        heroObs.observe(hero);
      } else if (mobileCta) {
        // ヒーローがないページでは常時表示
        mobileCta.classList.remove('is-hidden');
      }

      // Counter animation
      document.querySelectorAll('[data-count]').forEach(el => {
        const io = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          io.unobserve(el);
          const target = parseInt(el.getAttribute('data-count') || '0');
          const suffix = el.getAttribute('data-suffix') || '';
          const duration = 1500;
          const start = performance.now();
          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const ease = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(target * ease) + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }, { threshold: 0.5 });
        io.observe(el);
      });
    </script>
  </body>
</html>
