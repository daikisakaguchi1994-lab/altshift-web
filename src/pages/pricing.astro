---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const plans = [
  {
    num: '01',
    purpose: '集客を増やしたい方へ',
    name: 'AI検索対策',
    price: '55,000',
    unit: '円／月（税込）',
    note: '先着10社・特別モニター価格（通常 88,000円／月・税込）',
    desc: '月1回のオンライン取材から、note記事を月2本とホームページの更新を毎月。毎月、AIでの出方をご報告します。',
    small: '特別モニター価格は、記事の末尾に「編集・AEO最適化：AltShift」のクレジットを掲載させていただく条件です（完全非公開・黒子での対応は別途オプション）。',
    href: '/service/ai-search',
  },
  {
    num: '02',
    purpose: '手作業を減らしたい方へ',
    name: 'AI業務自動化',
    price: '個別見積もり',
    unit: '',
    note: '業務の洗い出しのあと、始める前に金額をお出しします',
    desc: '単発の業務自動化・LINE自動化から、AI内製化パッケージ、AI活用研修、カスタムシステム開発まで。',
    small: '補助金を活用できる場合があります（採択は審査によります）。',
    href: '/service/ai-automation',
  },
  {
    num: '03',
    purpose: 'まとめて任せたい方へ',
    name: 'AI顧問',
    price: '150,000〜300,000',
    unit: '円／月（税込）',
    note: '関わり方と支援の範囲に合わせてお見積もりします',
    desc: '外部CAIO（最高AI責任者）として、業務の自動化（守り）とAI検索対策（攻め）を標準で含め、毎月まとめて支援します。',
    small: 'AI検索対策の内容をすべて含みます。',
    href: '/service/ai-consulting',
  },
]

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '料金 | AltShift',
  description: 'AltShiftの3つの商品の料金。AI検索対策は先着10社が月額55,000円（税込）・通常88,000円（税込）、AI業務自動化は個別見積もり、AI顧問は月額150,000〜300,000円（税込）。',
  url: 'https://altshift.jp/pricing',
}
---

<Layout
  title="料金 | AI検索対策・AI業務自動化・AI顧問 | AltShift"
  description="AI検索対策は先着10社が月額55,000円（税込）・通常88,000円（税込）。AI業務自動化は個別見積もり。AI顧問は月額150,000〜300,000円（税込）。福岡発・全国対応のAltShift。"
  schemaData={schemaData}
>
  <Nav />
  <main>
    <section class="section-padding" style="background:var(--color-bg); padding-top:140px;">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="mb-14 reveal text-center">
          <div class="accent-line mb-6 mx-auto"></div>
          <h1 class="heading-hero" style="font-size:clamp(28px,4vw,48px);">料金</h1>
          <p class="body-lg mt-6" style="max-width:600px; margin:0 auto; line-height:1.8;">やりたいことに合わせて、3つから選べます。<br />迷ったら、30分の無料相談でお聞きします。</p>
        </div>

        <div class="flex flex-col gap-6">
          {plans.map((p, i) => (
            <div class={`reveal t-card p-6 md:p-10 grid grid-cols-1 md:grid-cols-5 gap-6 md:gap-10 items-start`} style={i === 0 ? 'border-color:rgba(27,94,190,0.3);' : ''}>
              <div class="md:col-span-2">
                <p class="service-num mb-2" style="font-size:24px;">{p.num}</p>
                <p class="text-sm font-semibold mb-1" style="color:var(--color-accent);">{p.purpose}</p>
                <h2 class="heading-lg" style="font-size:clamp(24px,3vw,32px);">{p.name}</h2>
              </div>
              <div class="md:col-span-3">
                <p style="color:var(--color-ink);" class="mb-1"><span class="number-value" style="font-size:clamp(26px,7vw,40px); color:var(--color-brand); white-space:nowrap;">{p.price}</span>{p.unit && <span class="text-sm" style="white-space:nowrap;">{p.unit}</span>}</p>
                <p class="text-sm mb-4" style="color:var(--color-ink-sub);">{p.note}</p>
                <p class="body-sm mb-3">{p.desc}</p>
                <p class="text-xs mb-4" style="color:var(--color-ink-sub); line-height:1.8;">{p.small}</p>
                <a href={p.href} class="neon-link" style="font-size:14px; min-height:44px; display:inline-flex; align-items:center;">{p.name}を見る <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
              </div>
            </div>
          ))}
        </div>

        <p class="body-sm text-center mt-10 reveal" style="color:var(--color-ink-sub);">料金や進め方のよくある質問は <a href="/faq" class="blue-link" style="display:inline;">よくある質問</a> をご覧ください。</p>

        <div class="reveal t-card flex flex-col md:flex-row items-center justify-between gap-6 p-8 mt-12">
          <div>
            <h2 class="heading-md mb-2">どれが合うか、一緒に決めます。</h2>
            <p class="body-sm">30分の無料相談で、いまの困りごとをお聞きします。オンラインで全国対応。</p>
          </div>
          <a href="/contact" class="btn-primary whitespace-nowrap flex-shrink-0">無料で相談する</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
