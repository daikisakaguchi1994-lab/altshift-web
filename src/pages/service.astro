---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const services = [
  {
    num: '01',
    title: 'AI検索対策',
    desc: '集客を増やしたい方へ。ChatGPT・Google・地図で、御社の名前が出る状態へ。月1回のオンライン取材から、note記事とホームページの更新を毎月続けます。先着10社は月額55,000円（税込）、通常は月額88,000円（税込）。',
    details: ['SEO・MEOとAIへの対策（AEO・GEO・LLMO・AIO）を一括で', '事実にもとづくnote記事を月2本', 'ホームページの情報の整合性を毎月更新', '毎月、AIでの出方をご報告'],
    image: '/images/services/web-seo.jpg',
    href: '/service/ai-search',
  },
  {
    num: '02',
    title: 'AI業務自動化',
    desc: '手作業を減らしたい方へ。見積もり・日報・問い合わせの返事など、毎日の手作業を減らす仕組みをつくります。料金は個別見積もり。',
    details: ['単発の業務自動化・LINE自動化', 'AI内製化パッケージ（3か月の伴走）', 'AI活用研修', 'カスタムシステム開発'],
    image: '/images/services/ai-system.jpg',
    href: '/service/ai-automation',
  },
  {
    num: '03',
    title: 'AI顧問',
    desc: 'まとめて任せたい方へ。外部CAIO（最高AI責任者）として、業務の自動化（守り）とAI検索対策（攻め）を標準で含め、毎月まとめて支援します。月額150,000〜300,000円（税込）。',
    details: ['AI検索対策の内容をすべて含む', '業務自動化の計画と仕組みづくり', '社員の方への研修・ルールづくり', '定例ミーティングとチャットでの相談'],
    image: '/images/services/caio-service.jpg',
    href: '/service/ai-consulting',
  },
]
---

<Layout title="サービス一覧 | AI検索対策・AI業務自動化・AI顧問 | AltShift" description="AltShiftの商品は3つ。集客を増やすAI検索対策、手作業を減らすAI業務自動化、両方をまとめて任せられるAI顧問。福岡発、全国対応。">
  <Nav />
  <main>
    <section class="section-padding" style="background:var(--color-bg); padding-top:140px;">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-16 reveal">
          <div class="accent-line mb-6"></div>
          <h1 class="heading-hero" style="font-size:clamp(28px,4vw,48px);">当社のサービス</h1>
          <p class="body-lg mt-4" style="max-width:640px;">やりたいことに合わせて、3つから選べます。迷ったら、30分の無料相談でお聞きします。</p>
        </div>

        <div class="flex flex-col gap-24">
          {services.map((s, i) => (
            <div class={`reveal grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${i % 2 !== 0 ? 'lg:[&>*:first-child]:order-2 lg:[&>*:last-child]:order-1' : ''}`}>
              <div>
                <p class="service-num mb-4">{s.num}</p>
                <h2 class="heading-lg mb-4">{s.title}</h2>
                <p class="body-md mb-8">{s.desc}</p>
                <ul class="flex flex-col gap-3 mb-8">
                  {s.details.map(item => (
                    <li class="flex items-center gap-3 text-sm" style="color:var(--color-ink);">
                      <div style="width:6px; height:6px; border-radius:50%; background:var(--color-primary); flex-shrink:0;"></div>
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="flex gap-6">
                  <a href={s.href} class="neon-link">
                    詳しく見る
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                  <a href="/contact" class="blue-link">
                    お問い合わせ
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                </div>
              </div>
              <!-- IMAGE SLOT -->
              <div class="media-slot" style="aspect-ratio:4/3;">
                <img src={s.image} alt={s.title} loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
