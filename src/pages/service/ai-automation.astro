---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

const menu = [
  { title: '単発の業務自動化', desc: '見積もり作成・日報の集計・問い合わせへの返事など、まず一つの業務から自動化します。', href: '/service/line-automation', link: 'LINE自動化をくわしく' },
  { title: 'AI内製化パッケージ', desc: '3か月、現場で一緒に仕組みをつくり、運用できる人を社内に残す伴走型の導入です。', href: '/#process', link: '3か月の流れを見る' },
  { title: 'AI活用研修', desc: '御社の仕事を題材に、社員の方が明日から自分でAIを使えるようにします。', href: '/service/ai-training', link: '研修をくわしく' },
  { title: 'カスタムシステム開発', desc: '既存の道具では足りない業務に、御社専用の仕組みをつくります。', href: '/service/ai-development', link: '開発をくわしく' },
]

const steps = [
  { num: '01', title: '無料相談（30分）', desc: 'いま時間を取られている業務をお聞きします。' },
  { num: '02', title: '業務の洗い出し', desc: 'AIに任せられる作業と、人がやるべき作業を分けます。' },
  { num: '03', title: 'お見積もり', desc: '範囲と金額を、始める前にお出しします。' },
  { num: '04', title: '仕組みづくり', desc: 'LINE・スプレッドシート・AIなど、なるべく今の道具のまま組み立てます。' },
  { num: '05', title: '使い方の研修・定着', desc: '社員の方が自分で回せるところまで付き合います。' },
]

const faqItems = [
  { q: '一つの業務だけでも頼めますか？', a: 'はい。見積もり作成や問い合わせへの返事など、一つの業務からお受けします。効果を確かめてから、範囲を広げることもできます。' },
  { q: '社内にAIやITに詳しい人がいなくても大丈夫ですか？', a: 'はい。専門用語を使わずにご説明し、社員の方が自分で使えるようになるまで研修でお手伝いします。' },
  { q: '料金はいくらですか？', a: '業務の内容と範囲によって変わるため、業務の洗い出しのあとに個別にお見積もりします。始める前に金額をお出しします。補助金を活用できる場合があります（採択は審査によります）。' },
]

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI業務自動化',
  provider: { '@type': 'Organization', '@id': 'https://altshift.jp/#organization', name: 'AltShift', url: 'https://altshift.jp' },
  areaServed: [{ '@type': 'City', name: '福岡市' }, { '@type': 'Country', name: '日本' }],
  serviceType: 'AI業務自動化（業務自動化・LINE自動化・AI内製化・AI活用研修・システム開発）',
  description: '見積もり・日報・問い合わせ対応など、中小企業の現場の手作業を減らす仕組みをつくる。単発の業務自動化から、AI内製化パッケージ、AI活用研修、カスタムシステム開発まで。料金は個別見積もり。',
  url: 'https://altshift.jp/service/ai-automation',
}
---

<Layout
  title="AI業務自動化 | 見積もり・日報・問い合わせの手作業を減らす | AltShift"
  description="見積もり・日報・問い合わせ対応・LINE自動化など、中小企業の手作業を減らす仕組みをつくります。単発の業務自動化から、AI内製化パッケージ、AI活用研修、カスタムシステム開発まで。料金は個別見積もり。福岡発・全国対応。"
  schemaData={schemaData}
>
  <Nav />
  <main>
    <section class="section-padding" style="background:var(--color-bg); padding-top:140px;">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">

        <div class="mb-16 reveal svc-head">
          <a href="/service" class="text-xs font-semibold mb-4 inline-flex items-center" style="color:var(--color-brand); letter-spacing:0.05em; min-height:44px;">← サービス一覧</a>
          <h1 class="svc-h1">
            <span class="svc-eyebrow"><i></i>02　AI業務自動化<span class="svc-for">手作業を減らしたい方へ</span></span>
            <span class="svc-title"><span class="nb">見積もりも、</span><span class="nb">日報も、</span><span class="nb">返事も。</span><br/><span class="nb">毎日の手作業を、</span><span class="nb">ひとつずつ手放す。</span></span>
          </h1>
          <p class="svc-lead"><strong>減らしたい作業を、ひとつ教えてください。</strong><br class="hidden md:inline"/>今の道具（LINE・スプレッドシートなど）のまま、AIが下書きまで済ませる形にします。<br class="hidden md:inline"/>金額は、始める前にお出しします。</p>

          <a href="/contact" class="svc-cta"><span>どの作業から減らせるか、30分で一緒に見る</span><i aria-hidden="true">→</i></a>
          <p class="svc-next">無料・オンライン。いま時間を取られている作業をお聞きします。相談だけで終わって大丈夫です。</p>

          <figure class="svc-vis">
            <figcaption class="svc-note">画面はイメージ（見本）</figcaption>
            <p class="svc-who">お客様からの問い合わせ</p>
            <p class="svc-in">来週、外壁の塗り替えの見積もりをお願いできますか？</p>
            <div class="svc-draft">
              <p class="svc-tag">AIが用意した返事の下書き</p>
              <p>お問い合わせありがとうございます。外壁の塗り替えのお見積もりですね。来週は ○日（火）の午後、○日（木）の午前に伺えます。ご都合はいかがでしょうか。</p>
              <p class="svc-send"><span>確認して送るだけ</span></p>
            </div>
            <p class="svc-sub">頼むと、こう進みます</p>
            <ul class="svc-three">
              <li><b>1つから</b>見積もり・日報・返事など、ひとつの作業から始められます</li>
              <li><b>先に金額</b>範囲と金額を、始める前にお出しします</li>
              <li><b>定着まで</b>社員の方が自分で回せるところまで付き合います</li>
            </ul>
          </figure>
          <p class="svc-promise">何時間減る、とは先に約束しません。約束するのは、始める前の金額と、社員の方が自分で回せるまでのお手伝いです。</p>
        </div>

        <!-- くわしい説明（もとの頭の文） -->
        <div class="reveal mb-20" style="max-width:760px;">
          <h2 class="heading-lg mb-6" style="font-size:clamp(22px,3vw,32px); line-height:1.5;">AI業務自動化とは</h2>
          <p class="heading-sm mb-4" style="line-height:1.6;">見積もり・日報・問い合わせの手作業を減らす。</p>
          <div class="body-md flex flex-col gap-4">
            <p>毎日くり返している手作業を、AIと今の道具（LINE・スプレッドシートなど）で減らす仕組みをつくります。</p>
            <p>単発の業務自動化から、<strong>AI内製化</strong>パッケージ、<strong>AI活用研修</strong>、カスタムシステム開発まで、御社の業務に合わせて組み立てます。</p>
          </div>
        </div>

        <!-- できること -->
        <div class="mb-20">
          <h2 class="heading-lg text-center mb-10 reveal">できること</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {menu.map(m => (
              <div class="reveal t-card p-6 md:p-8 flex flex-col">
                <h3 class="heading-md mb-3">{m.title}</h3>
                <p class="body-sm mb-4" style="color:var(--color-ink-sub);">{m.desc}</p>
                <a href={m.href} class="neon-link mt-auto" style="font-size:13px; min-height:44px; display:inline-flex; align-items:center;">{m.link} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
              </div>
            ))}
          </div>
        </div>

        <!-- 進め方 -->
        <div class="mb-20">
          <h2 class="heading-lg text-center mb-10 reveal">進め方</h2>
          <div class="flex flex-col gap-4" style="max-width:760px; margin:0 auto;">
            {steps.map(s => (
              <div class="reveal t-card p-6 flex gap-5 items-start">
                <p class="service-num" style="margin:0; font-size:24px;">{s.num}</p>
                <div>
                  <h3 class="heading-sm mb-1">{s.title}</h3>
                  <p class="body-sm" style="color:var(--color-ink-sub);">{s.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 料金 -->
        <div class="reveal t-card p-8 md:p-10 mb-12" style="border-color:rgba(27,94,190,0.25); max-width:760px; margin-left:auto; margin-right:auto;" id="price">
          <h2 class="heading-md mb-4">料金</h2>
          <p class="number-value mb-3" style="font-size:clamp(28px,6vw,36px); color:var(--color-brand);">個別見積もり</p>
          <p class="body-sm" style="color:var(--color-ink-sub);">業務の内容と範囲によって変わるため、業務の洗い出しのあとにお見積もりします。始める前に金額をお出しします。</p>
          <p class="body-sm mt-4" style="color:var(--color-ink-sub);">集客までまとめて任せたい方は、AI業務自動化の継続支援とAI検索対策を含む <a href="/service/ai-consulting" class="blue-link" style="display:inline;">AI顧問</a> をご覧ください。</p>
        </div>

        <!-- FAQ -->
        <div class="mb-20" style="max-width:760px; margin-left:auto; margin-right:auto;">
          <h2 class="heading-lg text-center mb-10 reveal">よくある質問</h2>
          <div class="flex flex-col gap-4">
            {faqItems.map(item => (
              <div class="reveal t-card p-6 md:p-8">
                <h3 class="heading-sm mb-3" style="line-height:1.6;">Q. {item.q}</h3>
                <p class="body-sm" style="line-height:1.9;">{item.a}</p>
              </div>
            ))}
          </div>
          <p class="body-sm text-center mt-6 reveal"><a href="/faq" class="blue-link" style="display:inline;">ほかの質問を見る</a></p>
        </div>

        <!-- CTA -->
        <div class="reveal t-card flex flex-col md:flex-row items-center justify-between gap-6 p-8">
          <div>
            <h3 class="heading-md mb-2">どの作業から減らせるか、一緒に見ます。</h3>
            <p class="body-sm">30分の無料相談で、いま時間を取られている業務をお聞きします。</p>
          </div>
          <a href="/contact" class="btn-primary whitespace-nowrap flex-shrink-0">無料で相談する</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .svc-h1 { display: block; font-weight: 700; }
  .svc-eyebrow { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 13px; font-weight: 500; letter-spacing: 0.04em; line-height: 1.6; color: var(--color-ink-sub); padding: 6px 16px; border: 1px solid var(--color-border); border-radius: 999px; margin: 8px 0 20px; }
  .svc-eyebrow i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-brand); }
  .svc-for { padding-left: 10px; border-left: 1px solid var(--color-border); }
  .svc-title { display: block; font-size: clamp(27px, 4.4vw, 50px); line-height: 1.3; letter-spacing: -0.012em; color: var(--color-ink); }
  .svc-title .nb { display: inline-block; }
  .svc-lead { font-size: 17px; line-height: 1.9; color: var(--color-ink-sub); margin-top: 20px; max-width: 720px; }
  .svc-lead strong { color: var(--color-ink); font-weight: 700; }
  .svc-vis { background: var(--color-bg-subtle); border-radius: 16px; padding: 20px; margin: 32px 0 0; max-width: 760px; }
  .svc-note, .svc-sub, .svc-who { font-size: 12px; color: var(--color-ink-dim); }
  .svc-note { text-align: right; }
  .svc-who { margin-top: 4px; }
  .svc-in { width: fit-content; max-width: 90%; margin-top: 6px; background: #fff; color: var(--color-ink); font-size: 15px; line-height: 1.7; padding: 10px 16px; border-radius: 16px 16px 16px 4px; box-shadow: 0 0 0 1px var(--color-border-card); }
  .svc-draft { max-width: 620px; width: 92%; margin: 12px 0 0 auto; background: #fff; color: var(--color-ink); font-size: 15px; line-height: 1.8; padding: 12px 16px 14px; border-radius: 16px 16px 4px 16px; border: 1.5px dashed rgba(27,94,190,0.45); }
  .svc-tag { display: inline-block; font-size: 12px; font-weight: 700; line-height: 1.6; color: var(--color-brand); background: rgba(27,94,190,0.12); padding: 1px 8px; border-radius: 6px; margin-bottom: 6px; }
  .svc-send { text-align: right; margin-top: 10px; }
  .svc-send span { display: inline-block; font-size: 13px; font-weight: 500; line-height: 1.6; color: #fff; background: var(--color-ink); padding: 5px 14px; border-radius: 999px; }
  .svc-sub { margin-top: 20px; }
  .svc-three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 8px; }
  .svc-three li { background: #fff; border-radius: 12px; padding: 14px; font-size: 14px; line-height: 1.7; color: var(--color-ink); box-shadow: 0 0 0 1px var(--color-border-card); }
  .svc-three b { display: block; font-family: 'Geist', 'M PLUS 1', sans-serif; font-size: 22px; line-height: 1.4; color: var(--color-brand); }
  .svc-cta { margin-top: 28px; display: inline-flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 56px; background: var(--color-ink); color: #fff; font-size: 16px; font-weight: 500; line-height: 1.5; padding: 8px 8px 8px 24px; border-radius: 999px; text-decoration: none; transition: transform 0.3s ease; }
  .svc-cta:hover { transform: translateY(-2px); }
  .svc-cta i { flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: var(--color-brand); display: grid; place-items: center; font-style: normal; }
  .svc-next { font-size: 14px; color: var(--color-ink-sub); margin-top: 12px; }
  .svc-promise { font-size: 14px; line-height: 1.8; color: var(--color-ink-sub); border-top: 1px solid var(--color-border); margin-top: 20px; padding-top: 14px; max-width: 760px; }
  @media (max-width: 640px) {
    .svc-lead { font-size: 16px; }
    .svc-three { grid-template-columns: 1fr; }
    .svc-three li { display: flex; align-items: baseline; gap: 12px; }
    .svc-three b { flex-shrink: 0; font-size: 18px; min-width: 76px; }
    .svc-cta { display: flex; border-radius: 28px; padding: 12px 12px 12px 20px; font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) { .svc-cta { transition: none; } .svc-cta:hover { transform: none; } }
</style>
