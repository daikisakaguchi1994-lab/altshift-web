---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

const includes = [
  '定例のオンラインミーティング（頻度は御社に合わせてご相談）',
  'チャットでの相談',
  '業務自動化の計画づくりと、仕組みづくりの継続支援（守り）',
  'AI検索対策の内容をすべて標準で含む：月1回の取材・note記事 月2本・ホームページの更新・毎月の出方のご報告（攻め）',
  '社員の方へのAI活用研修と、社内のAIの使い方のルールづくり',
  '新しいAIの道具の見極めと、使い方のご提案',
]

const steps = [
  { num: '01', title: 'ヒアリング', desc: '経営の課題と、集客・業務の困りごとをお聞きします。' },
  { num: '02', title: '計画づくり', desc: '早く効果が出る施策と、中長期で取り組むことを分けて計画します。' },
  { num: '03', title: '仕組みづくり・発信', desc: '業務の自動化と、AI検索対策の発信を並行して進めます。' },
  { num: '04', title: '毎月の見直し', desc: '結果を見ながら、次の月にやることを決めます。' },
]

const faqItems = [
  { q: 'AI検索対策と、何が違いますか？', a: 'AI顧問は、AI検索対策の内容をすべて含んだうえで、社内の業務の自動化や研修まで、毎月まとめて支援するプランです。集客（攻め）と業務（守り）の両方を任せたい方に向いています。' },
  { q: 'CAIOとは何ですか？', a: 'Chief AI Officer（最高AI責任者）の略で、会社のAIの活用を経営の視点で進める役割です。AI顧問では、AltShiftが社外からその役割を担います。' },
  { q: '料金はどう決まりますか？', a: '月額150,000〜300,000円（税込）の範囲で、関わり方と支援の範囲に合わせてお見積もりします。' },
]

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI顧問',
  alternateName: ['外部CAIO', 'AIコンサルティング'],
  provider: { '@type': 'Organization', '@id': 'https://altshift.jp/#organization', name: 'AltShift', url: 'https://altshift.jp' },
  areaServed: [{ '@type': 'City', name: '福岡市' }, { '@type': 'Country', name: '日本' }],
  serviceType: 'AI顧問（外部CAIO）',
  description: '経営者の右腕となる外部CAIO（最高AI責任者）として、社内の業務自動化（守り）と、AI検索対策（攻め）を標準で含めて毎月まとめて支援する月額プラン。',
  url: 'https://altshift.jp/service/ai-consulting',
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '150000',
    highPrice: '300000',
    priceCurrency: 'JPY',
    priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: '150000', maxPrice: '300000', priceCurrency: 'JPY', unitText: '月', valueAddedTaxIncluded: true },
  },
}
---

<Layout
  title="AI顧問 | 集客と業務の両方を毎月まとめて任せる | AltShift"
  description="経営者の右腕となる外部CAIO（最高AI責任者）として、業務の自動化（守り）とAI検索対策（攻め）を標準で含めて毎月まとめて支援するAI顧問。月額150,000〜300,000円（税込）。福岡発・全国対応。"
  schemaData={schemaData}
>
  <Nav />
  <main>
    <section class="section-padding" style="background:var(--color-bg); padding-top:140px;">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">

        <div class="mb-20 reveal">
          <a href="/service" class="text-xs font-semibold mb-4 inline-flex items-center" style="color:var(--color-brand); letter-spacing:0.05em; min-height:44px;">← サービス一覧</a>
          <p class="service-num mb-4">03</p>
          <p class="section-label mb-3" style="letter-spacing:0.1em; color:var(--color-accent);">まとめて任せたい方へ</p>
          <h1 class="heading-hero" style="font-size:clamp(30px,4.4vw,52px);">AI顧問</h1>
          <p class="heading-md mt-4" style="font-weight:600; line-height:1.6;">集客と業務の両方を、<br class="md:hidden"/>毎月まとめて任せる。</p>
          <div class="body-lg mt-6 flex flex-col gap-4" style="max-width:700px;">
            <p>経営者の右腕となる<strong>外部CAIO（最高AI責任者）</strong>的な伴走パートナーとして、AIの活用を経営の視点で進めます。</p>
            <p>社内の業務の自動化（守り）と、<a href="/service/ai-search" class="blue-link" style="display:inline;">AI検索対策</a>による集客・広報の発信（攻め）を標準で含め、毎月まとめて支援します。</p>
          </div>
        </div>

        <!-- 守りと攻め -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
          <div class="reveal t-card p-6 md:p-8">
            <p class="text-xs font-semibold mb-3" style="color:var(--color-brand); letter-spacing:0.1em;">守り</p>
            <h2 class="heading-md mb-3">業務の自動化</h2>
            <p class="body-sm" style="color:var(--color-ink-sub);">見積もり・日報・問い合わせ対応などの手作業を減らし、社員の方が自分でAIを使える状態をつくります。くわしくは <a href="/service/ai-automation" class="blue-link" style="display:inline;">AI業務自動化</a>。</p>
          </div>
          <div class="reveal t-card p-6 md:p-8">
            <p class="text-xs font-semibold mb-3" style="color:var(--color-brand); letter-spacing:0.1em;">攻め</p>
            <h2 class="heading-md mb-3">AI検索からの集客</h2>
            <p class="body-sm" style="color:var(--color-ink-sub);">ChatGPT・Google・地図で御社の名前が出るよう、取材・記事・ホームページの更新を毎月続けます。くわしくは <a href="/service/ai-search" class="blue-link" style="display:inline;">AI検索対策</a>。</p>
          </div>
        </div>

        <!-- 料金と内容 -->
        <div class="mb-20" id="price">
          <h2 class="heading-lg text-center mb-10 reveal">料金と内容</h2>
          <div class="reveal t-card p-8 md:p-10" style="border-color:rgba(27,94,190,0.25); max-width:760px; margin:0 auto;">
            <p style="color:var(--color-ink);" class="mb-1"><span class="number-value" style="font-size:clamp(26px,7vw,40px); color:var(--color-brand); white-space:nowrap;">150,000〜300,000</span><span class="text-sm" style="white-space:nowrap;">円／月（税込）</span></p>
            <p class="text-sm mb-8" style="color:var(--color-ink-sub);">関わり方と支援の範囲に合わせてお見積もりします</p>
            <ul class="flex flex-col gap-3">
              {includes.map(item => (
                <li class="flex items-start gap-2 text-sm" style="color:var(--color-ink);">
                  <div style="width:6px; height:6px; border-radius:50%; background:var(--color-brand); flex-shrink:0; margin-top:7px;"></div>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- 進め方 -->
        <div class="mb-20">
          <h2 class="heading-lg text-center mb-10 reveal">進め方</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" style="max-width:860px; margin:0 auto;">
            {steps.map(s => (
              <div class="reveal t-card p-6 flex gap-5 items-start">
                <p class="service-num" style="margin:0; font-size:24px;">{s.num}</p>
                <div>
                  <h3 class="heading-sm mb-1">{s.title}</h3>
                  <p class="body-sm" style="color:var(--color-ink-sub);">{s.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FAQ -->
        <div class="mb-20" style="max-width:760px; margin-left:auto; margin-right:auto;">
          <h2 class="heading-lg text-center mb-10 reveal">よくある質問</h2>
          <div class="flex flex-col gap-4">
            {faqItems.map(item => (
              <div class="reveal t-card p-6 md:p-8">
                <h3 class="heading-sm mb-3" style="line-height:1.6;">Q. {item.q}</h3>
                <p class="body-sm" style="line-height:1.9;">{item.a}</p>
              </div>
            ))}
          </div>
          <p class="body-sm text-center mt-6 reveal"><a href="/faq" class="blue-link" style="display:inline;">ほかの質問を見る</a></p>
        </div>

        <!-- CTA -->
        <div class="reveal t-card flex flex-col md:flex-row items-center justify-between gap-6 p-8">
          <div>
            <h3 class="heading-md mb-2">まずは無料相談（30分）から</h3>
            <p class="body-sm">集客と業務の困りごとを、まとめてお聞きします。オンラインで全国対応。</p>
          </div>
          <a href="/contact" class="btn-primary whitespace-nowrap flex-shrink-0">無料で相談する</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
