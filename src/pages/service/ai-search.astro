</style>

<script>
  // 見本の画面：最初に見えたときに1回だけ、質問 → 答えの順に出す
  const vis = document.querySelector('.svc-vis.is-ready');
  if (vis) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { vis.classList.add('is-in'); io.disconnect(); } });
    }, { threshold: 0.35 });
    io.observe(vis);
  }

  // 試せる質問：地域・業種・会社名を入れると文が変わり、ボタンでコピーできる（入力はどこにも送らない）
  const root = document.querySelector('.ais-try');
  if (root) {
    const vals = { area: '', job: '', name: '' };
    const defs = { area: '福岡市', job: '工務店', name: '○○工務店' };
    const lines = Array.from(root.querySelectorAll('[data-t]'));
    const render = () => lines.forEach((el) => {
      el.textContent = (el.getAttribute('data-t') || '').replace(/\[(\w+)\]/g, (_, k) => vals[k] || defs[k] || '');
    });
    root.querySelectorAll('input[data-k]').forEach((input) => {
      input.addEventListener('input', () => { vals[input.getAttribute('data-k')] = input.value.trim(); render(); });
    });
    const live = root.querySelector('.ais-live');
    root.querySelectorAll('.ais-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.parentElement.querySelector('[data-t]').textContent || '';
        try { await navigator.clipboard.writeText(text); }
        catch (err) {
          const ta = document.createElement('textarea');
          ta.value = text; document.body.appendChild(ta); ta.select();
          document.execCommand('copy'); ta.remove();
        }
        btn.textContent = 'コピーしました'; btn.classList.add('is-done');
        if (live) live.textContent = 'コピーしました';
        setTimeout(() => { btn.textContent = 'コピー'; btn.classList.remove('is-done'); if (live) live.textContent = ''; }, 2000);
      });
    });
  }
</script>
