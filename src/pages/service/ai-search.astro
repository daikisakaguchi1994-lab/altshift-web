---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

const includes = [
  '月1回のオンライン取材（30〜45分）で、現場の一次情報を整理',
  '事実にもとづくnote記事・コラムを月2本作成（お客様の名義で、確認のうえ公開）',
  'ホームページの情報の更新・構造化データの整備・整合性（辻褄）の見直しを毎月',
  '時事トレンドや最新の検索動向に合わせて、記事のテーマと情報を更新',
  'Googleマップ（Googleビジネスプロフィール）の情報との食い違いを点検',
  '毎月、ChatGPT・Gemini・Perplexity・Googleで御社がどう出ているかを確かめてご報告',
]

const faqItems = [
  {
    q: '従来のSEOや広告と、AI検索対策（AEO／GEO／LLMO）は何が違うのですか？',
    a: 'SEOは、Google検索の順位を上げてクリックしてもらう取り組みです。広告は、出稿している間だけ表示される「掛け捨て」の費用です。AI検索対策（AEO・GEO・LLMO・AIO）は、ChatGPTやGeminiなどのAIが答えを作るときに、御社の名前を出しやすいだけの裏付け（事実にもとづく記事と、辻褄の合った公式の情報）をWeb上に積み上げていく取り組みです。記事はお客様の名義・アカウントで公開するため、ご契約を終えたあともお客様の情報として残ります。',
  },
  {
    q: 'SEOやMEOは、やらなくてよいのですか？',
    a: 'いいえ。AIも検索エンジンやGoogleマップの情報を参考にするため、SEOとMEOは土台として欠かせません。AI検索対策では、SEO・MEOとAIへの対策（AEO・GEO・LLMO・AIO）を、ひとつの流れの中で一緒に進めます。',
  },
  {
    q: '必ずAIに推薦されるようになりますか？',
    a: 'お約束はできません。AIの仕組みは公開されておらず、変わり続けるためです。そのかわり、毎月「AIにどう出ているか」を実際に確かめ、結果をお見せしながら直していきます。',
  },
  {
    q: '記事の末尾のクレジット表記は、なくせますか？',
    a: 'はい。先着10社の特別モニター価格（月額55,000円・税込）は、記事の末尾に「編集・AEO最適化：AltShift」のクレジットを掲載させていただく条件です。クレジットを出さない完全非公開（黒子）での対応は、別途オプションでお受けします。',
  },
]

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI検索対策',
  alternateName: ['AEO対策', 'GEO対策', 'LLMO対策', 'AIO対策'],
  provider: { '@type': 'Organization', '@id': 'https://altshift.jp/#organization', name: 'AltShift', url: 'https://altshift.jp' },
  areaServed: { '@type': 'Country', name: '日本' },
  serviceType: 'AI検索対策（SEO・MEO・AEO・GEO・LLMO・AIO）',
  description: 'ChatGPT・Gemini・Perplexity・Google AI Overviewsなどで推薦されるための月額サービス。月1回のオンライン取材から、事実にもとづくnote記事とホームページの更新を毎月続ける。',
  url: 'https://altshift.jp/service/ai-search',
  offers: [
    {
      '@type': 'Offer',
      name: '特別モニター価格（先着10社・クレジット表記あり）',
      price: '55000',
      priceCurrency: 'JPY',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: '55000', priceCurrency: 'JPY', unitText: '月', valueAddedTaxIncluded: true },
    },
    {
      '@type': 'Offer',
      name: '通常価格',
      price: '88000',
      priceCurrency: 'JPY',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: '88000', priceCurrency: 'JPY', unitText: '月', valueAddedTaxIncluded: true },
    },
  ],
}

// よくある質問の構造化データ（FAQPage）は /faq とトップにだけ出す（同じ質問を重ねないため）
---

<Layout
  title="AI検索対策 | ChatGPT・Google・地図で推薦される会社へ | AltShift"
  description="ChatGPT・Gemini・Perplexity・Google AI Overviewsで推薦されるためのAI検索対策（AEO・GEO・LLMO・AIO）を、SEO・MEOと一括で。月1回のオンライン取材から、note記事とホームページの更新を毎月。先着10社は月額55,000円（税込）。全国オンライン対応。"
  schemaData={schemaData}
>
  <Nav />
  <main>
    <section class="section-padding" style="background:var(--color-bg); padding-top:140px;">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">

        <div class="mb-16 reveal svc-head">
          <a href="/service" class="text-xs font-semibold mb-4 inline-flex items-center" style="color:var(--color-brand); letter-spacing:0.05em; min-height:44px;">← サービス一覧</a>
          <h1 class="svc-h1">
            <span class="svc-eyebrow"><i></i>01　AI検索対策<span class="svc-for">集客を増やしたい方へ</span></span>
            <span class="svc-title"><span class="nb">お客様は、もう</span><span class="nb">AIに聞いています。</span><br/><span class="nb">その答えに、</span><span class="nb">御社の名前を。</span></span>
          </h1>
          <p class="svc-lead"><strong>月に30〜45分、話すだけ。</strong>取材も、執筆も、ホームページの手直しも、こちらで行います。<br class="hidden md:inline"/>毎月2本の記事が、御社の名前で残ります。</p>

          <a href="/contact" class="svc-cta"><span>いまAIが御社をどう答えるか、30分で確かめる</span><i aria-hidden="true">→</i></a>
          <p class="svc-next">無料・オンライン。その場で一緒にAIに聞いてみます。相談だけで終わって大丈夫です。</p>

          <figure class="svc-vis">
            <figcaption class="svc-note">画面はイメージ（見本）</figcaption>
            <p class="svc-q">福岡で、雨漏りに強い工務店は？</p>
            <p class="svc-a">福岡市で雨漏りの修理に強い会社としては、<mark>○○工務店</mark> があります。築30年以上の木造の事例を、自社の記事でくわしく公開しており…</p>
            <p class="svc-sub">毎月、届くもの</p>
            <ul class="svc-three">
              <li><b>2本</b>御社の名義の記事（確認のうえ公開）</li>
              <li><b>1回</b>ホームページと地図の情報の点検・更新</li>
              <li><b>1通</b>AIが御社をどう答えたかの報告</li>
            </ul>
          </figure>
          <script is:inline>
            (function () {
              var v = document.querySelector('.svc-vis');
              if (v && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) v.classList.add('is-ready');
            })();
          </script>

          <p class="svc-promise">AIに必ず名前が出る、とは約束しません。約束するのは、毎月2本の記事と、毎月の報告です。</p>
        </div>

        <!-- 自分で確かめる（試せる質問） -->
        <div class="reveal mb-16 ais-block" id="try">
          <h2 class="ais-h2">まず、ご自分で確かめられます。</h2>
          <p class="ais-lead">下の質問を、ChatGPT などにそのまま貼ってみてください。</p>
          <div class="ais-try">
            <div class="ais-fields">
              <label>地域<input type="text" data-k="area" placeholder="福岡市" autocomplete="off" /></label>
              <label>業種<input type="text" data-k="job" placeholder="工務店" autocomplete="off" /></label>
              <label>会社名<input type="text" data-k="name" placeholder="○○工務店" autocomplete="off" /></label>
            </div>
            <ol class="ais-prompts">
              <li><p data-t="[area]で、[job]のおすすめの会社を教えてください。">福岡市で、工務店のおすすめの会社を教えてください。</p><button type="button" class="ais-copy">コピー</button></li>
              <li><p data-t="[name]は、どんな会社ですか？強みと所在地を教えてください。">○○工務店は、どんな会社ですか？強みと所在地を教えてください。</p><button type="button" class="ais-copy">コピー</button></li>
              <li><p data-t="[area]の[job]を選ぶとき、何を比べればよいですか？会社名も挙げてください。">福岡市の工務店を選ぶとき、何を比べればよいですか？会社名も挙げてください。</p><button type="button" class="ais-copy">コピー</button></li>
            </ol>
            <p class="ais-live" aria-live="polite"></p>
          </div>
          <p class="ais-after">名前が出ない。内容が違う。そのときは、<a href="/contact" class="blue-link" style="display:inline;">30分で一緒に原因を見ます</a>。</p>
        </div>

        <!-- 辻褄（エンティティ・E-E-A-T）：図で見せ、もとの文は「くわしく見る」に残す -->
        <div class="reveal mb-16 ais-block">
          <h2 class="ais-h2">AIに「同じ会社」と分かってもらい、<br class="hidden md:inline"/>「信頼できる」と判断してもらう。</h2>
          <figure class="ais-ba">
            <table>
              <thead>
                <tr><td></td><th scope="col">頼む前</th><th scope="col" class="is-after">頼んだあと</th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">ホームページ</th><td>社名だけ</td><td class="is-after">社名・住所・強み</td></tr>
                <tr><th scope="row">地図</th><td>前の住所のまま</td><td class="is-after">今の住所</td></tr>
                <tr><th scope="row">記事</th><td>なし</td><td class="is-after">毎月2本、事例を公開</td></tr>
                <tr class="ais-ba-ai"><th scope="row">AIから見ると</th><td>どの会社か、決めにくい</td><td class="is-after">同じ会社だと、照らし合わせやすい</td></tr>
              </tbody>
            </table>
            <figcaption class="svc-note">図はイメージ（見本）</figcaption>
          </figure>
          <details class="ais-more">
            <summary>くわしく見る</summary>
            <div class="body-md flex flex-col gap-4 ais-more-body">
              <p>AIは、ネット上のさまざまな情報を照らし合わせて答えを作ります。社名・所在地・事業内容がページごとにばらばらだと、別の会社と取り違えられることがあります（<a href="/glossary#entity" class="blue-link" style="display:inline;">エンティティ</a>の認識）。</p>
              <p>また、現場の経験や実績にもとづく一次情報ほど、信頼できる情報として評価されやすくなります（<a href="/glossary#eeat" class="blue-link" style="display:inline;">E-E-A-T</a>）。</p>
              <p>月1回のオンライン取材（30〜45分）をもとに、時事トレンドや最新の検索動向に合わせて、ホームページ・note・Googleマップの情報の整合性を毎月アップデートします。</p>
            </div>
          </details>
        </div>

        <!-- 毎月の流れ（社長がやること） -->
        <div class="reveal mb-16 ais-block">
          <h2 class="ais-h2">社長がやるのは、2つだけ。</h2>
          <figure class="ais-flow">
            <ol class="ais-you">
              <li><b>1</b><span>月に1回、30〜45分話す</span></li>
              <li><b>2</b><span>できた記事を確認する</span></li>
            </ol>
            <div class="ais-we">
              <p>あとは、こちらで</p>
              <ul>
                <li>取材の整理</li>
                <li>記事の執筆</li>
                <li>ホームページと地図の更新</li>
                <li>AIでの出方の確認と報告</li>
              </ul>
            </div>
          </figure>
        </div>

        <!-- 積み上がる資産：図で見せ、もとの文は「くわしく見る」に残す -->
        <div class="reveal mb-16 ais-block">
          <h2 class="ais-h2">掛け捨ての広告費を、<br/>毎月積み上がる「集客の資産」に変える。</h2>
          <figure class="ais-stack">
            <div class="ais-stack-row">
              <p class="ais-stack-t">広告<span>止めると、表示も止まる</span></p>
              <div class="ais-bars ais-bars-ad" aria-hidden="true">
                {Array.from({ length: 12 }).map((_, i) => <span class={i > 5 ? 'off' : ''}></span>)}
              </div>
              <p class="ais-stack-n"><span>掲載中</span><span>止めたあと</span></p>
            </div>
            <div class="ais-stack-row">
              <p class="ais-stack-t">記事<span>毎月2本ずつ。やめても残る</span></p>
              <div class="ais-bars ais-bars-art" aria-hidden="true">
                {Array.from({ length: 12 }).map((_, i) => <span style={`height:${Math.round(((i + 1) / 12) * 100)}%`}></span>)}
              </div>
              <p class="ais-stack-n"><span>1か月 2本</span><span>1年 24本</span></p>
            </div>
            <figcaption class="svc-note">図はイメージ</figcaption>
          </figure>
          <details class="ais-more">
            <summary>くわしく見る</summary>
            <ul class="flex flex-col gap-4 ais-more-body">
              {[
                'リスティング広告や求人広告は、出稿を止めると流入も止まりやすい「掛け捨て」のコストです。',
                'AI検索対策では、ホームページ（公式の一次情報）と、毎月2本の事実にもとづくnote記事（外の場所での発信）を連動させ、第三者に紹介・引用される（サイテーション）きっかけを増やします。',
                '記事はお客様の名義で公開するため、ご契約を終えたあともお客様の情報として残り、続けるほど、検索エンジンとAIに見つけてもらうための材料が積み上がります。',
                '毎月の取材の対話から業務のボトルネックも見えてくるため、AI業務自動化へもつなげやすくなります。',
              ].map(t => (
                <li class="flex items-start gap-3 body-md">
                  <div style="width:6px; height:6px; border-radius:50%; background:var(--color-brand); flex-shrink:0; margin-top:12px;"></div>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </details>
        </div>

        <!-- 料金と内容 -->
        <div class="mb-20" id="price">
          <h2 class="heading-lg text-center mb-10 reveal">料金と内容</h2>
          <div class="reveal t-card p-8 md:p-10" style="border-color:rgba(27,94,190,0.25); max-width:760px; margin:0 auto;">
            <div class="flex flex-col md:flex-row md:items-end gap-4 md:gap-10 mb-6">
              <div>
                <p class="text-sm font-semibold" style="color:var(--color-accent);">先着10社・特別モニター価格</p>
                <p style="color:var(--color-ink);"><span class="number-value" style="font-size:clamp(32px,8vw,44px); color:var(--color-brand); white-space:nowrap;">55,000</span><span class="text-sm" style="white-space:nowrap;">円／月（税込）</span></p>
              </div>
              <div>
                <p class="text-sm" style="color:var(--color-ink-sub);">通常価格</p>
                <p style="color:var(--color-ink-sub);"><span class="number-value" style="font-size:24px; white-space:nowrap;">88,000</span><span class="text-sm" style="white-space:nowrap;">円／月（税込）</span></p>
              </div>
            </div>
            <p class="ais-price-sum">毎月：取材1回・記事2本・点検と更新・出方の報告</p>
            <details class="ais-more mb-6">
              <summary>含まれる内容（6つ）を見る</summary>
              <ul class="flex flex-col gap-3 ais-more-body">
                {includes.map(item => (
                  <li class="flex items-start gap-2 text-sm" style="color:var(--color-ink);">
                    <div style="width:6px; height:6px; border-radius:50%; background:var(--color-brand); flex-shrink:0; margin-top:7px;"></div>
                    {item}
                  </li>
                ))}
              </ul>
            </details>
            <p class="text-xs" style="color:var(--color-ink-sub); line-height:1.8;">※特別モニター価格は、記事の末尾に「編集・AEO最適化：AltShift」のクレジットを掲載させていただく条件です（完全非公開・黒子での対応は別途オプション）。</p>
            <p class="text-xs" style="color:var(--color-ink-sub); line-height:1.8;">ホームページの作り直しが必要な場合は、<a href="/service/web-seo" class="blue-link" style="display:inline;">Web制作</a>を別途お見積もりします。</p>
          </div>
          <p class="body-sm text-center mt-6 reveal" style="color:var(--color-ink-sub);">業務の自動化までまとめて任せたい方は、AI検索対策を標準で含む <a href="/service/ai-consulting" class="blue-link" style="display:inline;">AI顧問</a> をご覧ください。</p>
        </div>

        <!-- くわしい説明・よくある質問（答えは開いて読む。文はもとのまま） -->
        <div class="mb-20" style="max-width:760px; margin-left:auto; margin-right:auto;">
          <h2 class="heading-lg text-center mb-10 reveal">よくある質問</h2>
          <div class="reveal">
            <details class="ais-faq">
              <summary><h3>AI検索対策とは（言葉の説明）</h3></summary>
              <div class="body-sm flex flex-col gap-4" style="line-height:1.9;">
                <p>Google検索で順位を競う時代から、ChatGPT・Gemini・Perplexity・Google AI OverviewsなどのAIが「おすすめの会社」を直接答える時代へ移りつつあります。</p>
                <p>AI検索対策では、従来の<strong>SEO</strong>（Google検索）と<strong>MEO</strong>（Googleマップ）に加えて、AIの回答で推薦されるための<strong>AEO</strong>（回答エンジン最適化）・<strong>GEO</strong>（生成エンジン最適化）・<strong>LLMO</strong>（大規模言語モデル最適化）・<strong>AIO</strong>（AI最適化）に一括で対応します。</p>
                <p>言葉の意味は <a href="/glossary" class="blue-link" style="display:inline;">AI・検索用語集</a> でくわしく説明しています。</p>
              </div>
            </details>
            {faqItems.map(item => (
              <details class="ais-faq">
                <summary><h3>Q. {item.q}</h3></summary>
                <p class="body-sm" style="line-height:1.9;">{item.a}</p>
              </details>
            ))}
          </div>
          <p class="body-sm text-center mt-6 reveal"><a href="/faq" class="blue-link" style="display:inline;">ほかの質問を見る</a></p>
        </div>

        <!-- CTA -->
        <div class="reveal t-card flex flex-col md:flex-row items-center justify-between gap-6 p-8">
          <div>
            <h3 class="heading-md mb-2">御社は、AIにどう紹介されていますか？</h3>
            <p class="body-sm">30分の無料相談で、いまの出方を一緒に確かめます。オンラインで全国対応。</p>
          </div>
          <a href="/contact" class="btn-primary whitespace-nowrap flex-shrink-0">無料で相談する</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .svc-h1 { display: block; font-weight: 700; }
  .svc-eyebrow { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 13px; font-weight: 500; letter-spacing: 0.04em; line-height: 1.6; color: var(--color-ink-sub); padding: 6px 16px; border: 1px solid var(--color-border); border-radius: 999px; margin: 8px 0 20px; }
  .svc-eyebrow i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-brand); }
  .svc-for { padding-left: 10px; border-left: 1px solid var(--color-border); }
  .svc-title { display: block; font-size: clamp(27px, 4.4vw, 50px); line-height: 1.3; letter-spacing: -0.012em; color: var(--color-ink); }
  .svc-title .nb { display: inline-block; }
  .svc-lead { font-size: 17px; line-height: 1.9; color: var(--color-ink-sub); margin-top: 20px; max-width: 720px; }
  .svc-lead strong { color: var(--color-ink); font-weight: 700; }
  .svc-vis { background: var(--color-bg-subtle); border-radius: 16px; padding: 20px; margin: 32px 0 0; max-width: 760px; }
  .svc-note, .svc-sub { font-size: 12px; color: var(--color-ink-dim); }
  .svc-note { text-align: right; }
  .svc-q { width: fit-content; max-width: 90%; margin: 8px 0 0 auto; background: var(--color-ink); color: #fff; font-size: 15px; line-height: 1.7; padding: 10px 16px; border-radius: 16px 16px 4px 16px; }
  .svc-a { max-width: 620px; width: 92%; margin-top: 10px; background: #fff; color: var(--color-ink); font-size: 15px; line-height: 1.8; padding: 12px 16px; border-radius: 16px 16px 16px 4px; box-shadow: 0 0 0 1px var(--color-border-card); }
  .svc-a mark { background: rgba(27,94,190,0.12); color: var(--color-brand); font-weight: 700; padding: 1px 6px; border-radius: 6px; }
  .svc-sub { margin-top: 20px; }
  .svc-three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 8px; }
