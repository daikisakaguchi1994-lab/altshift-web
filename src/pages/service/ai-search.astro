---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

const includes = [
  '月1回のオンライン取材（30〜45分）で、現場の一次情報を整理',
  '事実にもとづくnote記事・コラムを月2本作成（お客様の名義で、確認のうえ公開）',
  'ホームページの情報の更新・構造化データの整備・整合性（辻褄）の見直しを毎月',
  '時事トレンドや最新の検索動向に合わせて、記事のテーマと情報を更新',
  'Googleマップ（Googleビジネスプロフィール）の情報との食い違いを点検',
  '毎月、ChatGPT・Gemini・Perplexity・Googleで御社がどう出ているかを確かめてご報告',
]

const faqItems = [
  {
    q: '従来のSEOや広告と、AI検索対策（AEO／GEO／LLMO）は何が違うのですか？',
    a: 'SEOは、Google検索の順位を上げてクリックしてもらう取り組みです。広告は、出稿している間だけ表示される「掛け捨て」の費用です。AI検索対策（AEO・GEO・LLMO・AIO）は、ChatGPTやGeminiなどのAIが答えを作るときに、御社の名前を出しやすいだけの裏付け（事実にもとづく記事と、辻褄の合った公式の情報）をWeb上に積み上げていく取り組みです。記事はお客様の名義・アカウントで公開するため、ご契約を終えたあともお客様の情報として残ります。',
  },
  {
    q: 'SEOやMEOは、やらなくてよいのですか？',
    a: 'いいえ。AIも検索エンジンやGoogleマップの情報を参考にするため、SEOとMEOは土台として欠かせません。AI検索対策では、SEO・MEOとAIへの対策（AEO・GEO・LLMO・AIO）を、ひとつの流れの中で一緒に進めます。',
  },
  {
    q: '必ずAIに推薦されるようになりますか？',
    a: 'お約束はできません。AIの仕組みは公開されておらず、変わり続けるためです。そのかわり、毎月「AIにどう出ているか」を実際に確かめ、結果をお見せしながら直していきます。',
  },
  {
    q: '記事の末尾のクレジット表記は、なくせますか？',
    a: 'はい。先着10社の特別モニター価格（月額55,000円・税込）は、記事の末尾に「編集・AEO最適化：AltShift」のクレジットを掲載させていただく条件です。クレジットを出さない完全非公開（黒子）での対応は、別途オプションでお受けします。',
  },
]

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI検索対策',
  alternateName: ['AEO対策', 'GEO対策', 'LLMO対策', 'AIO対策'],
  provider: { '@type': 'Organization', '@id': 'https://altshift.jp/#organization', name: 'AltShift', url: 'https://altshift.jp' },
  areaServed: { '@type': 'Country', name: '日本' },
  serviceType: 'AI検索対策（SEO・MEO・AEO・GEO・LLMO・AIO）',
  description: 'ChatGPT・Gemini・Perplexity・Google AI Overviewsなどで推薦されるための月額サービス。月1回のオンライン取材から、事実にもとづくnote記事とホームページの更新を毎月続ける。',
  url: 'https://altshift.jp/service/ai-search',
  offers: [
    {
      '@type': 'Offer',
      name: '特別モニター価格（先着10社・クレジット表記あり）',
      price: '55000',
      priceCurrency: 'JPY',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: '55000', priceCurrency: 'JPY', unitText: '月', valueAddedTaxIncluded: true },
    },
    {
      '@type': 'Offer',
      name: '通常価格',
      price: '88000',
      priceCurrency: 'JPY',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: '88000', priceCurrency: 'JPY', unitText: '月', valueAddedTaxIncluded: true },
    },
  ],
}

// よくある質問の構造化データ（FAQPage）は /faq とトップにだけ出す（同じ質問を重ねないため）

// 1画面目の下の「数字の帯」
const facts = [
  { k: '月額（先着10社）', pre: '', n: '55,000', post: '円〜', s: '税込。通常は 88,000円' },
  { k: '御社の名義の記事', pre: '月', n: '2', post: '本', s: '確認のうえ公開' },
  { k: '社長の時間', pre: '月', n: '30〜45', post: '分', s: 'オンラインで話すだけ' },
  { k: '対応エリア', pre: '', n: '全国', post: '', s: 'すべてオンライン' },
]

const worries = [
  'ChatGPT に聞いても、自社の名前が出てこない',
  '広告を止めると、問い合わせも止まる',
  '記事やSNSを続ける時間も、人もいない',
]

// AI が参考にする3つの情報（仕組みの図）
const sources = [
  { icon: 'web', t: 'ホームページ', d: '公式の情報。社名・住所・強み' },
  { icon: 'doc', t: '記事（note）', d: '現場の事例を、毎月2本' },
  { icon: 'pin', t: 'Googleマップ', d: '住所・営業時間・口コミ' },
]

const terms = [
  { t: 'SEO', d: 'Google検索で見つけてもらう' },
  { t: 'MEO', d: 'Googleマップで見つけてもらう' },
  { t: 'LLMO・AIO', d: 'AIの答えに出やすくする' },
]

const monthly = [
  { k: '取材', pre: '月', n: '1', post: '回', d: '30〜45分。オンラインで話すだけ。' },
  { k: '記事', pre: '月', n: '2', post: '本', d: '御社の名義で公開。確認のうえで。' },
  { k: '点検・レポート', pre: '月', n: '1', post: '回', d: 'ホームページと地図を更新。AIでの出方を報告。' },
]

const reasons = [
  { t: '掛け捨てにしない', d: '記事は御社の名義で公開。ご契約を終えても、御社の情報として残ります。' },
  { t: 'SEO・MEO・AIを一括で', d: '窓口はひとつ。月額もひとつ。ばらばらに頼む手間がありません。' },
  { t: '結果を、毎月見せる', d: 'AIが御社をどう答えたかを、毎月確かめて報告します。' },
]

const flow = [
  { t: '無料診断', d: '30分・オンライン。AIでの出方を一緒に確認' },
  { t: 'お申し込み', d: '最低3か月。その後は1か月ごと' },
  { t: '毎月スタート', d: '取材 → 記事の公開 → レポート' },
]

const planTicks = [
  'オンライン取材 月1回（30〜45分）',
  '記事 月2本（御社の名義・確認のうえ公開）',
  'ホームページとGoogleマップの点検・更新',
  'AIでの出方のレポート（ChatGPT・Gemini ほか）',
]

const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>'
const tick = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1b5ebe" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>'
const icons = {
  web: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1b5ebe" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></svg>',
  doc: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1b5ebe" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/></svg>',
  pin: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1b5ebe" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>',
}
const spark = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#8fb8ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.500M15.5 15.5 18 18M18 6l-2.5 2.500M8.5 15.5 6 18"/></svg>'
---

<Layout
  title="AI検索対策 | ChatGPT・Google・地図で推薦される会社へ | AltShift"
  description="ChatGPT・Gemini・Perplexity・Google AI Overviewsで推薦されるためのAI検索対策（AEO・GEO・LLMO・AIO）を、SEO・MEOと一括で。月1回のオンライン取材から、note記事とホームページの更新を毎月。先着10社は月額55,000円（税込）。全国オンライン対応。"
  schemaData={schemaData}
>
  <Nav />
<div class="sp">
  <main>

    <!-- 1 最初の画面：だれの・何を・いくらで・次に何をするか -->
    <section class="hero">
      <div class="wrap">
        <a href="/service" class="back">← サービス一覧</a>
        <div class="hero-grid">
          <div class="hero-copy">
            <h1>
              <span class="eyebrow"><i class="dot"></i>01　AI検索対策<span class="for">集客を増やしたい方へ</span></span>
              <span class="title"><span class="nb">お客様は<span class="p">、</span>もう</span><span class="nb">AIに聞いています<span class="p">。</span></span><br/><span class="nb">その答えに<span class="p">、</span></span><span class="nb">御社の名前を<span class="p">。</span></span></span>
            </h1>
            <p class="lead">ChatGPT・GoogleのAI・Googleマップで<strong>「選ばれる会社」</strong>へ。SEO・MEO・LLMO（AI検索）の対策を、<span class="nb">取材から公開まで<strong>まるごと代行</strong>します。</span></p>
            <div class="cta">
              <a class="btn btn-1" href="/contact">AI検索の無料診断（30分）<span class="ic" set:html={arrow}></span></a>
              <a class="btn btn-2" href="#price">料金を見る</a>
            </div>
            <p class="micro">オンライン・無料。その場で、AIに御社のことを聞いてみます。</p>
          </div>

          <figure class="mock">
            <div class="shell"><div class="core">
              <div class="mock-top"><b><i></i>AIアシスタント</b><span>画面はイメージ（見本）</span></div>
              <div class="mock-body">
                <p class="q">福岡で、雨漏りに強い工務店は？</p>
                <div class="a">
                  <p>福岡市で雨漏りの修理に強い会社としては、<mark>○○工務店</mark>があります。築30年以上の木造の事例を、自社の記事でくわしく公開しています。</p>
                  <div class="src">
                    <small>参考にした情報</small>
                    <ul><li>ホームページ</li><li>note の記事</li><li>Googleマップ</li></ul>
                  </div>
                </div>
              </div>
            </div></div>
          </figure>
          <script is:inline>
            (function () {
              var v = document.querySelector('.sp .mock');
              if (v && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) v.classList.add('is-ready');
            })();
          </script>
        </div>

        <ul class="facts">
          {facts.map(f => (
            <li><small>{f.k}</small><b>{f.pre}<em>{f.n}</em>{f.post}</b><span>{f.s}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 2 お悩み ＋ 30秒セルフチェック -->
    <section class="sec" id="check">
      <div class="wrap">
        <div class="sec-head rv">
          <div><p class="label"><span class="mono">01</span>お悩み</p><h2>こんなお悩み<span class="p">、</span><br class="sp-br"/>ありませんか<span class="p">。</span></h2></div>
          <p>ひとつでも当てはまれば、AI検索対策が役に立ちます。</p>
        </div>
        <div class="worry-grid">
          <ul class="worries rv">
            {worries.map(w => (<li><span class="ck" set:html={tick}></span>{w}</li>))}
          </ul>
          <div class="shell rv selfcheck"><div class="core">
            <p class="tag">30秒でできる　セルフチェック</p>
            <h3>いま、AIは御社を答えますか。</h3>
            <p class="prompt"><span class="pq">「</span><input type="text" data-k="area" placeholder="福岡市" aria-label="地域" autocomplete="off" />で、おすすめの<input type="text" data-k="job" placeholder="工務店" aria-label="業種" autocomplete="off" />を教えてください<span class="pq">」</span></p>
            <button type="button" class="btn btn-1 copy"><span class="copy-t">この質問をコピー</span><span class="ic" set:html={arrow}></span></button>
            <p class="hint">青い所は書きかえられます。ChatGPT などに貼るだけ。</p>
            <p class="live" aria-live="polite"></p>
            <p class="next">名前が出なかったら、<a href="/contact">無料診断で原因を一緒に見ます</a>。</p>
          </div></div>
        </div>
      </div>
    </section>

    <!-- 3 AI検索対策とは：仕組みを1枚の図で -->
    <section class="sec tint" id="about">
      <div class="wrap">
        <div class="sec-head rv">
          <div><p class="label"><span class="mono">02</span>AI検索対策とは</p><h2>AIは<span class="p">、</span>3つの情報を<br class="sp-br"/>見て答えます<span class="p">。</span></h2></div>
          <p>その3つを毎月整えて、AIの答えに出やすくする。それが、AI検索対策（LLMO・AIO）です。</p>
        </div>

        <figure class="mech rv">
          <ul class="mech-src">
            {sources.map(s => (
              <li><span class="mi" set:html={icons[s.icon]}></span><div><b>{s.t}</b><span>{s.d}</span></div></li>
            ))}
          </ul>
          <svg class="join" viewBox="0 0 56 240" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C30 40 26 120 56 120"/><path d="M0 120 H56"/><path d="M0 200 C30 200 26 120 56 120"/></svg>
          <span class="down" aria-hidden="true"></span>
          <div class="mech-ai">
            <span set:html={spark}></span>
            <b>AI</b>
            <small>ChatGPT・Gemini・<br/>Google など</small>
          </div>
          <svg class="to" viewBox="0 0 40 12" aria-hidden="true"><path d="M0 6h36M31 1.5 36 6l-5 4.5"/></svg>
          <span class="down" aria-hidden="true"></span>
          <div class="shell mech-ans"><div class="core">
            <small>AIの答え</small>
            <p>「…としては、<mark>○○工務店</mark>があります」</p>
            <span class="ok"><span set:html={tick}></span>御社の名前が、答えの中に</span>
          </div></div>
          <figcaption>図はイメージ（見本）</figcaption>
        </figure>

        <ul class="terms rv">
          {terms.map(t => (<li><b>{t.t}</b><span>{t.d}</span></li>))}
        </ul>
        <p class="terms-sum rv">この3つを、<strong>ひとつの月額でまとめて</strong>行います。</p>

        <details class="more rv">
          <summary>くわしく見る</summary>
          <div class="more-body">
            <p>Google検索で順位を競う時代から、ChatGPT・Gemini・Perplexity・Google AI OverviewsなどのAIが「おすすめの会社」を直接答える時代へ移りつつあります。</p>
            <p>AI検索対策では、従来の<strong>SEO</strong>（Google検索）と<strong>MEO</strong>（Googleマップ）に加えて、AIの回答で推薦されるための<strong>AEO</strong>（回答エンジン最適化）・<strong>GEO</strong>（生成エンジン最適化）・<strong>LLMO</strong>（大規模言語モデル最適化）・<strong>AIO</strong>（AI最適化）に一括で対応します。</p>
            <p>AIは、ネット上のさまざまな情報を照らし合わせて答えを作ります。社名・所在地・事業内容がページごとにばらばらだと、別の会社と取り違えられることがあります（<a href="/glossary#entity">エンティティ</a>の認識）。</p>
            <p>また、現場の経験や実績にもとづく一次情報ほど、信頼できる情報として評価されやすくなります（<a href="/glossary#eeat">E-E-A-T</a>）。</p>
            <p>月1回のオンライン取材（30〜45分）をもとに、時事トレンドや最新の検索動向に合わせて、ホームページ・note・Googleマップの情報の整合性を毎月アップデートします。</p>
            <p>言葉の意味は <a href="/glossary">AI・検索用語集</a> でくわしく説明しています。</p>
          </div>
        </details>
      </div>
    </section>

    <!-- 4 サービス内容：毎月すること -->
    <section class="sec" id="service">
      <div class="wrap">
        <div class="sec-head rv">
          <div><p class="label"><span class="mono">03</span>サービス内容・ご利用の流れ</p><h2>毎月<span class="p">、</span>ここまで<br class="sp-br"/>代行します<span class="p">。</span></h2></div>
          <p>社長にお願いするのは、話すことと、できた記事の確認だけです。</p>
        </div>
        <ul class="monthly">
          {monthly.map((m, i) => (
            <li class="shell rv"><div class="core">
              <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
              <small>{m.k}</small>
              <b>{m.pre}<em>{m.n}</em>{m.post}</b>
              <p>{m.d}</p>
            </div></li>
          ))}
        </ul>
        <div class="roles rv" role="img" aria-label="役割の分担。社長は、話すことと確認すること。AltShift は、整理・執筆・更新・点検・報告。">
          <div class="you"><small>社長</small><b>話す・確認する</b></div>
          <div class="we"><small>AltShift</small><b>整理・執筆・更新・点検・報告</b></div>
        </div>
        <div class="flow rv">
          <h3>ご利用の流れ</h3>
          <ol class="steps">
            {flow.map((s, i) => (
              <li><span class="n mono">STEP {i + 1}</span><b>{s.t}</b><small>{s.d}</small></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 5 3つの特長 -->
    <section class="sec tint" id="reason">
      <div class="wrap">
        <div class="sec-head rv">
          <div><p class="label"><span class="mono">04</span>3つの特長</p><h2>掛け捨ての広告費を<span class="p">、</span><br/>積み上がる資産に<span class="p">。</span></h2></div>
          <p>広告は、止めると表示も止まります。記事は、止めても残ります。</p>
        </div>
        <div class="reason-grid">
          <ol class="reasons rv">
            {reasons.map((r, i) => (
              <li><span class="mono n">{String(i + 1).padStart(2, '0')}</span><div><h3>{r.t}</h3><p>{r.d}</p></div></li>
            ))}
          </ol>
          <figure class="stack shell rv"><div class="core">
            <div class="stack-row">
              <p class="stack-t">広告<span>止めると、表示も止まる</span></p>
              <div class="bars bars-ad" aria-hidden="true">
                {Array.from({ length: 12 }).map((_, i) => <span class={i > 5 ? 'off' : ''}></span>)}
              </div>
              <p class="stack-n"><span>掲載中</span><span>止めたあと</span></p>
            </div>
            <div class="stack-row">
              <p class="stack-t">記事<span>毎月2本ずつ、積み上がる</span></p>
              <div class="bars bars-art" aria-hidden="true">
                {Array.from({ length: 12 }).map((_, i) => <span style={`height:${Math.round(((i + 1) / 12) * 100)}%`}></span>)}
              </div>
              <p class="stack-n"><span>1か月 2本</span><span>1年 24本</span></p>
            </div>
            <figcaption>図はイメージ</figcaption>
          </div></figure>
        </div>
        <p class="promise rv">AIに必ず名前が出る、とは約束しません。約束するのは、毎月2本の記事と、毎月の報告です。</p>
        <details class="more rv">
          <summary>くわしく見る</summary>
          <ul class="more-body dots">
            <li>リスティング広告や求人広告は、出稿を止めると流入も止まりやすい「掛け捨て」のコストです。</li>
            <li>AI検索対策では、ホームページ（公式の一次情報）と、毎月2本の事実にもとづくnote記事（外の場所での発信）を連動させ、第三者に紹介・引用される（サイテーション）きっかけを増やします。</li>
            <li>記事はお客様の名義で公開するため、ご契約を終えたあともお客様の情報として残り、続けるほど、検索エンジンとAIに見つけてもらうための材料が積み上がります。</li>
            <li>毎月の取材の対話から業務のボトルネックも見えてくるため、AI業務自動化へもつなげやすくなります。</li>
          </ul>
        </details>
      </div>
    </section>

    <!-- 6 料金プラン -->
