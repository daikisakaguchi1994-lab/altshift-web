<script>
  // 画面に入ったら、下から静かに出す（JavaScript が動かなくても本文は見える）
  const sp = document.querySelector('.sp');
  if (sp && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('rv-on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    sp.classList.add('rv-ready');
    sp.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // 見本の画面：最初に見えたときに1回だけ、質問 → 答え → 参考にした情報 の順に出す
    const mock = sp.querySelector('.mock.is-ready');
    if (mock) {
      const mo = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { mock.classList.add('is-in'); mo.disconnect(); } }), { threshold: 0.35 });
      mo.observe(mock);
    }
  }

  // セルフチェック：地域と業種を書きかえて、質問をコピーできる（入力はどこにも送らない）
  const box = document.querySelector('.selfcheck');
  if (box) {
    const inputs = Array.from(box.querySelectorAll('input[data-k]')) as HTMLInputElement[];
    const fit = (el: HTMLInputElement) => { el.style.width = `${Math.max(3, (el.value || el.placeholder).length) + 1.4}em`; };
    inputs.forEach((el) => { fit(el); el.addEventListener('input', () => fit(el)); });
    const val = (k: string) => { const el = inputs.find((x) => x.dataset.k === k); return el ? (el.value.trim() || el.placeholder) : ''; };
    const btn = box.querySelector('.copy');
    const label = box.querySelector('.copy-t');
    const live = box.querySelector('.live');
    btn?.addEventListener('click', async () => {
      const text = `${val('area')}で、おすすめの${val('job')}を教えてください。`;
      try { await navigator.clipboard.writeText(text); }
      catch (err) {
        const ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
      }
      if (label) label.textContent = 'コピーしました';
      if (live) live.textContent = 'コピーしました';
      setTimeout(() => { if (label) label.textContent = 'この質問をコピー'; if (live) live.textContent = ''; }, 2000);
    });
  }
</script>

